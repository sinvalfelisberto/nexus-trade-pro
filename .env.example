# =============================================================
# NEXUS TRADE PRO - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values.
# All app settings are read from .env (it takes precedence over system
# environment variables). API keys are reloaded automatically when the
# file changes; the other settings require restarting the server.

# brapi.dev - Brazilian Stock Market API (free tier: 15,000 req/month)
# Get your token at: https://brapi.dev/dashboard
BRAPI_TOKEN=your_brapi_token_here
# Simultaneous requests allowed by your brapi plan (free plan: 1)
BRAPI_MAX_CONCURRENT=1

# =============================================================
# B3 HISTORY DATABASE (MySQL) - optional, see docs/HISTORICO_B3.md
# =============================================================
# Official B3 daily history (COTAHIST files) stored in MySQL, used by the charts.
# Leave DB_OLD_HOST empty to fetch chart history from brapi instead
# (brapi free plan: only 3 months of history).
# Tables are created with the "bolsa_" prefix inside DB_OLD_NAME
# (bolsa_cotacoes_diarias, bolsa_arquivos_importados). The user needs
# CREATE, INSERT, UPDATE, DELETE and SELECT on that database.
# Initial load (~6 min, ~1.45M rows / ~280 MB for 5 years):
#   python3 core/b3_history.py --carga
# e.g. DB_OLD_HOST=your-mysql-host.example.com
DB_OLD_HOST=
DB_OLD_PORT=3306
DB_OLD_NAME=your_database
DB_OLD_USER=your_user
DB_OLD_PASS=your_password

# Years of history kept in the database
B3_HISTORY_YEARS=5
# B3 CODBDI codes to import: 02 stocks, 12 FII, 14 ETF/certificates, 34 BDR
B3_CODBDI=02,12,14,34
# How often the server imports missing trading days (hours)
B3_UPDATE_HOURS=6

# Tavily AI - News and Sentiment API (free tier: 1,000 req/month)
# Get your key at: https://tavily.com
TAVILY_KEY=your_tavily_key_here

# WhatsApp Alerts (optional)
WHATSAPP_NUMBER=+5511999999999

# =============================================================
# SERVER
# =============================================================

# Host/port for the HTTP server and dashboard (http://localhost:SERVER_PORT/dashboard)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =============================================================
# TRADING CONFIGURATION
# =============================================================

# Mode: PAPER (simulated) or REAL (live trading)
TRADING_MODE=PAPER

# Broker: MT5 (MetaTrader 5) or BTG
BROKER_NAME=MT5

# MetaTrader 5 Credentials (fill after installing MT5)
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=

# =============================================================
# RISK MANAGEMENT (Conservative defaults)
# =============================================================

# Initial capital (synced with dashboard)
INITIAL_CAPITAL=500

# Maximum order value in BRL
MAX_ORDER_VALUE=300

# Daily loss limit in BRL
DAILY_LOSS_LIMIT=150

# Risk per trade (percentage of capital)
RISK_PER_TRADE=1.0

# Maximum simultaneous positions
MAX_POSITIONS=3

# Minimum score for buy signal
MIN_SCORE_BUY=35

# Minimum score for sell signal
MIN_SCORE_SELL=-35

# Default Stop Loss percentage
STOP_LOSS_PERCENT=4.0

# Default Take Profit percentage
TAKE_PROFIT_PERCENT=8.0

# Minimum signal confidence
MIN_CONFIDENCE=55

# Minimum daily volume (in shares) - currently not read by the code
MIN_VOLUME=1000000

# Trading hours (Brazilian market)
TRADING_START=10:00
TRADING_END=16:30
LUNCH_START=12:00
LUNCH_END=13:30

# Ignore trading hours in simulation mode
IGNORE_TRADING_HOURS=true
